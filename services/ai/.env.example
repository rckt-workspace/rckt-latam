# ============================================
# RCKT AI Service Configuration
# ============================================
# Copy this file to .env and fill in your values
# $ cp .env.example .env

# Application
APP_ENV=development
APP_NAME=rckt-ai
APP_VERSION=0.1.0

# ============================================
# LLM PROVIDERS (At least ONE is REQUIRED)
# ============================================

# Primary Provider - Anthropic Claude
# Get key from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Fallback Provider - OpenRouter (for redundancy/availability)
# Get key from: https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Provider Routing
# Default: OpenRouter PRIMARY (free models), Anthropic FALLBACK (higher quality)
LLM_PROVIDER=openrouter
LLM_FALLBACK_PROVIDER=anthropic

# ============================================
# LOVABLE CLOUD BRIDGE (OPTIONAL - for persistence)
# ============================================
# Edge Function URL for database operations
LOVABLE_DB_BRIDGE_URL=

# Internal secret for Edge Function authentication
RCKT_INTERNAL_SECRET=cambiar-en-produccion-generado-con-openssl-rand-hex-32

# Legacy: Supabase URL (optional, for reference)
SUPABASE_URL=

# ============================================
# OBSERVABILITY (OPTIONAL)
# ============================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# CORS - Web frontend origins
# ============================================
# Configured in app/core/config.py
# Default allows: localhost:5173 (dev), *.rckt.latam (prod)
